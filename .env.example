# ── Telegram ──────────────────────────────────────────────────────
API_ID=
API_HASH=
CHANNEL_NAME=intelligent_trading_signals

# ── Binance Futures Testnet ────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
TRADING_SYMBOL=BTC/USDT
LEVERAGE=10

# ── Risk Management (NEW) ─────────────────────────────────────────
# Trade duration before force-close (seconds)
TRADE_DURATION_SECONDS=60
# Stop-loss distance from entry price (0.005 = 0.5%)
STOP_LOSS_PCT=0.005
# Take-profit distance from entry price (0.010 = 1.0%)
TAKE_PROFIT_PCT=0.010
# Trailing stop distance (0 = disabled, 0.003 = 0.3%)
TRAILING_STOP_PCT=0.003
# Max number of open positions simultaneously
MAX_CONCURRENT_TRADES=3
# Min seconds between same-side trades (prevents signal spam)
SIGNAL_COOLDOWN_SECONDS=30
# Emergency halt: stop trading when daily loss exceeds this (USDT)
DAILY_LOSS_LIMIT_USDT=50.0
# Binance taker/maker fees
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0004

# ── App ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/trades.db
PORT=8000

# ── Safety override ───────────────────────────────────────────────
# ALLOW_PRODUCTION=false
